# Copie este arquivo para ".env" e ajuste os valores.

# String de conexão do PostgreSQL
# Formato: postgresql+psycopg2://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql+psycopg2://vokalboard_user:vokalboard_pass@localhost:5432/vokalboard

# Chave secreta usada para assinar o cookie de sessão (login).
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# Backend de envio de e-mail: "console" (padrão, só imprime no log — bom
# para desenvolvimento) ou "resend" (envia de verdade via api.resend.com)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM="VokalBoard <onboarding@resend.dev>"

# CAPTCHA (Cloudflare Turnstile) no cadastro e em "esqueci minha senha"
# — OPCIONAL. Sem essas duas chaves, o site continua protegido só pelo
# honeypot (ver app/captcha.py), que já barra os bots mais simples sem
# precisar de nenhuma conta externa. Pra ligar o Turnstile de verdade:
# crie uma conta grátis em https://dash.cloudflare.com/ → Turnstile →
# Add site, e cole as duas chaves abaixo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pasta onde as fotos de perfil (avatares) são salvas, já convertidas
# pra .webp e redimensionadas (ver app/avatars.py). Em produção, isso
# PRECISA apontar pra um disco persistente (um "Volume" no Railway, ou
# o equivalente em qualquer outra hospedagem) — senão as fotos somem a
# cada novo deploy, porque o disco do container é apagado toda vez.
# Sem essa variável, cai em "app/static/avatars" (só serve pra rodar
# localmente, onde isso não é um problema).
AVATAR_DIR=app/static/avatars

# Mesma lógica do AVATAR_DIR acima, mas para as imagens inseridas
# dentro de posts pelo editor estilo WordPress (ver app/post_images.py).
POST_IMAGE_DIR=app/static/post_images

# Em produção (Railway, Ocean, qualquer host com HTTPS de verdade na
# frente), coloque "true" aqui — faz o cookie de login só ser enviado
# em conexões HTTPS, e liga o cabeçalho HSTS (ver
# SecurityHeadersMiddleware em app/main.py). Deixe "false" (ou de fora
# do .env) pra rodar localmente sem HTTPS.
SESSION_COOKIE_SECURE=false

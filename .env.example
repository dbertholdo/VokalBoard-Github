# Copy this file to ".env" and adjust the values.

# PostgreSQL connection string
# Format: postgresql+psycopg2://user:password@host:port/database_name
DATABASE_URL=postgresql+psycopg2://vokalboard_user:vokalboard_pass@localhost:5432/vokalboard

# Secret key used to sign the session (login) cookie.
# Generate a new one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# Email sending backend: "console" (default, just prints to the log —
# good for development) or "resend" (sends for real via api.resend.com)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM="VokalBoard <onboarding@resend.dev>"

# CAPTCHA (Cloudflare Turnstile) on signup and "forgot password" —
# OPTIONAL. Without these two keys, the site stays protected by the
# honeypot alone (see app/captcha.py), which already blocks the
# simplest bots with no external account needed. To actually enable
# Turnstile: create a free account at https://dash.cloudflare.com/ →
# Turnstile → Add site, and paste the two keys below.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Folder where profile photos (avatars) are saved, already converted
# to .webp and resized (see app/avatars.py). In production, this
# MUST point to a persistent disk (a "Volume" on Railway, or the
# equivalent on any other host) — otherwise the photos disappear on
# every new deploy, because the container's disk gets wiped each time.
# Without this variable, it falls back to "app/static/avatars" (only
# fine for running locally, where this isn't an issue).
AVATAR_DIR=app/static/avatars

# Same logic as AVATAR_DIR above, but for images inserted inside posts
# via the WordPress-style editor (see app/post_images.py).
POST_IMAGE_DIR=app/static/post_images

# In production (Railway, Ocean, any host with real HTTPS in front),
# set this to "true" — it makes the login cookie only get sent over
# HTTPS connections, and turns on the HSTS header (see
# SecurityHeadersMiddleware in app/main.py). Leave it "false" (or
# leave it out of .env) to run locally without HTTPS.
SESSION_COOKIE_SECURE=false

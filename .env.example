# VokalBoard — example environment file. Copy to `.env` and fill in.
# `.env` itself is git-ignored (never commit real secrets, only this file).

# ---- Database (required) ----------------------------------------------
# SQLAlchemy connection string. Locally this points at the Postgres
# container from docker-compose.yml (or a local install — see README).
# On Railway, this is the Postgres service's connection string.
DATABASE_URL=postgresql+psycopg2://vokalboard_user:vokalboard_pass@localhost:5432/vokalboard_dev

# ---- Session / cookies (required in production) ------------------------
# Session cookies are signed with this. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Using the default dev value in production is a real security hole —
# the app prints a warning on startup if this isn't set.
SECRET_KEY=

# Set to true in production (HTTPS) so session cookies aren't sent over
# plain HTTP. Keep false for local http://localhost dev.
SESSION_COOKIE_SECURE=false

# ---- Email (see README "Email in production" for the full story) ------
# console (default): prints emails to the server log instead of sending —
#   fine for local dev, useless in production (nobody sees the log).
# resend: actually sends via the Resend API (https://resend.com).
EMAIL_BACKEND=console

# Only used when EMAIL_BACKEND=resend. Get this from your Resend
# dashboard. If EMAIL_BACKEND=resend but this is empty, sending silently
# falls back to console-only (nothing is delivered) — the app now logs a
# loud warning when that happens (fixed 19/09/2026).
RESEND_API_KEY=

# The "From" address Resend sends as. IMPORTANT: the default below
# (onboarding@resend.dev) is Resend's shared TEST sender — it can only
# deliver to the email address on your own Resend account, never to
# other people. To actually email your users, verify your own domain in
# the Resend dashboard and put a real address on it here, e.g.
# "VokalBoard <no-reply@vokalboard.example>".
EMAIL_FROM="VokalBoard <onboarding@resend.dev>"

# Public base URL (no trailing slash) — used to build the logo image URL
# inside outgoing emails. Without it, emails send but without a logo.
SITE_BASE_URL=

# ---- Rechnungmaker / invoice drafts (required for that feature) -------
# Fernet key used to encrypt invoice-draft form data at rest (IBAN, tax
# ID, address — see CLAUDE.md's Zero-Storage policy). Without this set,
# starting a Rechnung draft fails outright. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVOICE_DRAFT_ENCRYPTION_KEY=

# ---- Anti-bot (optional — honeypot alone protects if left empty) ------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- File storage directories (optional — sane defaults if unset) -----
AVATAR_DIR=app/static/avatars
POST_IMAGE_DIR=app/static/post_images
RECEIPT_DIR=app/static/receipts

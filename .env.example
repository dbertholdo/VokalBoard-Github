# Copie este arquivo para ".env" e ajuste os valores.

# String de conexão do PostgreSQL
# Formato: postgresql+psycopg2://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql+psycopg2://vokalboard_user:vokalboard_pass@localhost:5432/vokalboard

# Chave secreta usada para assinar o cookie de sessão (login).
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# Backend de envio de e-mail: "console" (padrão, só imprime no log — bom
# para desenvolvimento) ou "resend" (envia de verdade via api.resend.com)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM="VokalBoard <onboarding@resend.dev>"

# CAPTCHA (Cloudflare Turnstile) no cadastro e em "esqueci minha senha"
# — OPCIONAL. Sem essas duas chaves, o site continua protegido só pelo
# honeypot (ver app/captcha.py), que já barra os bots mais simples sem
# precisar de nenhuma conta externa. Pra ligar o Turnstile de verdade:
# crie uma conta grátis em https://dash.cloudflare.com/ → Turnstile →
# Add site, e cole as duas chaves abaixo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
